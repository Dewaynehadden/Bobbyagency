# Values shown are configuration names, not real credentials.
AUDIT_ALLOWED_ORIGIN=https://dewaynehadden.github.io
AUDIT_DAILY_LIMIT=30
# Gmail on free hosting: use the provided Google Apps Script connector.
EMAIL_PROVIDER=google_script
GOOGLE_MAIL_URL=
GOOGLE_MAIL_TOKEN=
